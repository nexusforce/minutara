<?xml version="1.0" encoding="utf-8"?>
<!-- Copied next to Scribe.exe and scribe-cli.exe as <name>.exe.config.
     Lets .NET Framework load Scribe's window library even if Windows still
     marks the files as downloaded (a zip extracted without "Unblock"). -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
